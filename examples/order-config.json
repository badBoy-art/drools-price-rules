{
  "ruleName": "order_approval",
  "businessType": "ORDER",
  "fields": [
    {
      "name": "orderAmount",
      "type": "NUMBER",
      "required": true,
      "description": "订单总金额，业务方按同币种及税费口径汇总后传入",
      "example": 15000
    },
    {
      "name": "customerLevel",
      "type": "STRING",
      "required": true,
      "description": "客户会员等级，用于匹配会员折扣策略",
      "example": "VIP"
    },
    {
      "name": "overdue",
      "type": "BOOLEAN",
      "required": true,
      "description": "客户是否存在逾期账款，true时拒绝订单",
      "example": false
    },
    {
      "name": "tags",
      "type": "STRING_LIST",
      "required": false,
      "description": "订单业务标签，跨境或高风险标签触发追加审批",
      "example": [
        "CROSS_BORDER"
      ]
    },
    {
      "name": "region",
      "type": "STRING",
      "required": false,
      "description": "订单地区标识，可用于扩展地区策略",
      "example": "CN"
    }
  ],
  "rules": [
    {
      "id": "small_order",
      "name": "小额订单",
      "kind": "BASE",
      "priority": 0,
      "when": {
        "field": "orderAmount",
        "operator": "LE",
        "value": 10000
      },
      "actions": [
        {
          "type": "AUTO_APPROVE"
        }
      ]
    },
    {
      "id": "large_order",
      "name": "大额订单",
      "kind": "BASE",
      "priority": 0,
      "when": {
        "field": "orderAmount",
        "operator": "GT",
        "value": 10000
      },
      "actions": [
        {
          "type": "REQUIRE_APPROVAL",
          "mode": "SERIAL",
          "targets": [
            "ROLE:SALES_MANAGER"
          ]
        }
      ]
    },
    {
      "id": "vip_discount",
      "name": "会员折扣",
      "kind": "SUPPLEMENT",
      "priority": 10,
      "when": {
        "logic": "ALL",
        "conditions": [
          {
            "field": "customerLevel",
            "operator": "IN",
            "value": [
              "VIP",
              "SVIP"
            ]
          },
          {
            "logic": "NOT",
            "conditions": [
              {
                "field": "overdue",
                "operator": "EQ",
                "value": true
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "SET_RESULT",
          "key": "discountRate",
          "value": 0.95
        }
      ]
    },
    {
      "id": "high_risk",
      "name": "高风险追加审批",
      "kind": "SUPPLEMENT",
      "priority": 20,
      "when": {
        "logic": "ANY",
        "conditions": [
          {
            "field": "orderAmount",
            "operator": "GE",
            "value": 50000
          },
          {
            "field": "tags",
            "operator": "CONTAINS_ANY",
            "value": [
              "HIGH_RISK",
              "CROSS_BORDER"
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "APPEND_APPROVAL",
          "mode": "PARALLEL",
          "targets": [
            "ROLE:FINANCE",
            "ROLE:RISK"
          ]
        },
        {
          "type": "CC_AFTER_APPROVAL",
          "targets": [
            "ROLE:BUSINESS_LEADER"
          ]
        }
      ]
    },
    {
      "id": "overdue_reject",
      "name": "逾期拒绝",
      "kind": "SUPPLEMENT",
      "priority": 100,
      "when": {
        "field": "overdue",
        "operator": "EQ",
        "value": true
      },
      "actions": [
        {
          "type": "REJECT",
          "reason": "客户存在逾期账款"
        }
      ]
    }
  ],
  "outputs": [
    {
      "name": "discountRate",
      "type": "NUMBER",
      "required": false,
      "description": "会员折扣系数，0.95表示按95折计算；非会员或逾期时可不返回",
      "example": 0.95
    }
  ]
}
