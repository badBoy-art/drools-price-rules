{
  "ruleName": "nested_order_approval",
  "businessType": "ORDER",
  "fields": [
    {
      "name": "customer.address.province", "type": "STRING", "required": true,
      "description": "客户地址中的省份，由页面选择客户/地址/省份得到路径", "example": "浙江"
    },
    {
      "name": "orderAmount", "type": "NUMBER", "required": true,
      "description": "订单金额，可与多层属性一起作为规则条件", "example": 15000
    }
  ],
  "outputs": [
    {"name": "reviewRegion", "type": "STRING", "required": true, "description": "本次订单审核区域标识", "example": "LOCAL"}
  ],
  "rules": [
    {
      "id": "local_customer", "name": "浙江客户订单", "kind": "BASE", "priority": 0,
      "when": {"field": "customer.address.province", "operator": "EQ", "value": "浙江"},
      "actions": [
        {"type": "REQUIRE_APPROVAL", "mode": "SERIAL", "targets": ["ROLE:SALES_MANAGER"]},
        {"type": "SET_RESULT", "key": "reviewRegion", "value": "LOCAL"}
      ]
    },
    {
      "id": "other_customer", "name": "其他省份客户订单", "kind": "BASE", "priority": 0,
      "when": {"field": "customer.address.province", "operator": "NE", "value": "浙江"},
      "actions": [
        {"type": "AUTO_APPROVE"},
        {"type": "SET_RESULT", "key": "reviewRegion", "value": "REMOTE"}
      ]
    }
  ]
}
