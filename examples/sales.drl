then
    result.match("sales_price:default:risk1", "SUPPLEMENT", 0, 4, "[{\"type\":\"CC_AFTER_APPROVAL\",\"targets\":[\"ROLE:RISK_CONTROL\",\"ROLE:BUSINESS_LEADER\"]}]");
end

