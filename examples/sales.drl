    eval(($fact.test("policyId", "EQ", "\"default\"")) && ($fact.test("grossMarginPct", "GT", "5")) && ($fact.test("grossMarginPct", "LE", "1E+1")))
then
    result.match("sales_price:default:band3", "BASE", 0, 2, "[{\"type\":\"AUTO_APPROVE\"}]");
end

