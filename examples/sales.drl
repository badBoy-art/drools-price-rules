package example.generated

import example.rules.GenericFact;
global example.rules.GenericRuleResult result;
dialect "java"

rule "sales_price:default:band1"
when
    $fact : GenericFact(businessType == "SALES_PRICE")
    eval(($fact.test("policyId", "EQ", "\"default\"")) && ($fact.test("grossMarginPct", "LE", "0")))
then
    result.match("sales_price:default:band1", "BASE", 0, 0, "[{\"type\":\"REQUIRE_APPROVAL\",\"mode\":\"SERIAL\",\"targets\":[\"ROLE:PURCHASE_PLUS_1\",\"ROLE:PURCHASE_PLUS_2\"]}]");
end

rule "sales_price:default:band2"
when
    $fact : GenericFact(businessType == "SALES_PRICE")
    eval(($fact.test("policyId", "EQ", "\"default\"")) && ($fact.test("grossMarginPct", "GT", "0")) && ($fact.test("grossMarginPct", "LE", "5")))
then
    result.match("sales_price:default:band2", "BASE", 0, 1, "[{\"type\":\"REQUIRE_APPROVAL\",\"mode\":\"SERIAL\",\"targets\":[\"ROLE:PURCHASE_PLUS_1\"]}]");
end

