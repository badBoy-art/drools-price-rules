{
  "ruleName" : "generic_sales",
  "businessType" : "SALES_PRICE",
  "fields" : [ {
    "name" : "grossMarginPct",
    "type" : "NUMBER",
    "required" : true
  }, {
    "name" : "salePrice",
    "type" : "NUMBER",
    "required" : true
  }, {
    "name" : "costPrice",
    "type" : "NUMBER",
    "required" : true
  }, {
    "name" : "productId",
    "type" : "STRING",
    "required" : true
  } ],
  "calculation" : {
    "type" : "GROSS_MARGIN",
    "baseField" : "salePrice",
    "compareField" : "costPrice",
    "resultField" : "grossMarginPct"
  },
  "rules" : [ {
    "id" : "low",
    "kind" : "BASE",
    "priority" : 0,
    "when" : {
      "field" : "grossMarginPct",
      "operator" : "LE",
      "value" : 10
    },
    "actions" : [ {
      "type" : "AUTO_APPROVE"
    } ]
  }, {
    "id" : "high",
    "kind" : "BASE",
    "priority" : 0,
    "when" : {
      "field" : "grossMarginPct",
      "operator" : "GT",
      "value" : 10
    },
    "actions" : [ {
      "type" : "REQUIRE_APPROVAL",
      "mode" : "SERIAL",
      "targets" : [ "ROLE:MANAGER" ]
    } ]
  }, {
    "id" : "raw_price",
    "kind" : "SUPPLEMENT",
    "priority" : 0,
    "when" : {
      "logic" : "ALL",
      "conditions" : [ {
        "field" : "salePrice",
        "operator" : "GE",
        "value" : 1000
      }, {
        "field" : "productId",
        "operator" : "EQ",
        "value" : "SKU"
      } ]
    },
    "actions" : [ {
      "type" : "SET_RESULT",
      "key" : "largePrice",
      "value" : true
    } ]
  } ]
}
